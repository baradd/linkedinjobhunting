# ── Telegram ────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# OPTIONAL. Normally leave this empty: the first chat that sends /start to the bot is paired
# automatically and remembered in Redis (no restart needed). Set it only to pin the bot to one chat.
TELEGRAM_CHAT_ID=
# OPTIONAL but recommended: a secret word that must be sent to pair, so a stranger who finds
# your bot's username can't claim it first. Pair with: /start <secret>  (or t.me/<bot>?start=<secret>)
BOT_PAIRING_SECRET=

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Matching ────────────────────────────────────────────────
# Initial keywords (can be changed later from Telegram with /add and /remove)
DEFAULT_KEYWORDS=node.js,nodejs,node,nestjs
DEFAULT_EXCLUDES=intern,internship
# Ignore postings older than this many days
MAX_AGE_DAYS=7
# Also search the job description (first 1500 chars), not only title + tags
MATCH_DESCRIPTION=true

# ── Source polling intervals (minutes) ──────────────────────
REMOTIVE_INTERVAL_MIN=360
ARBEITNOW_INTERVAL_MIN=30
EMAIL_INTERVAL_MIN=10

# ── LinkedIn job-alert emails via IMAP (optional but recommended) ──
# Gmail: imap.gmail.com / 993 / an App Password (needs 2-step verification)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_FROM=jobalerts-noreply@linkedin.com
